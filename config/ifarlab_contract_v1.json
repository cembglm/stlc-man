{
  "contract": "asrlab-ifarlab-traceability",
  "schema_version": "1.0",
  "rule_set_version": "1.0",
  "submission_id_pattern": "^S-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}$",
  "run_id_pattern": "^R-[0-9]{8}-[0-9]{4}$",
  "requirement_id_pattern": "^(FR|NFR)-[0-9]{3}$",
  "test_case_id_pattern": "^[A-Z][A-Z0-9_]*_[0-9]{3}$",
  "metric_naming": "snake_case with unit suffix where applicable",
  "operators": ["==", "!=", "<", "<=", ">", ">=", "in", "not_in"],
  "test_verdicts": ["PASS", "FAIL", "INCONCLUSIVE"],
  "requirement_states": ["PASS", "FAIL", "NOT_VERIFIED", "NOT_COVERED", "STALE"],
  "rtf_minimum": 0.7,
  "collision_source": "MoveIt /sim/check_state_validity",
  "general_rules": [
    {"metric": "collision_count", "operator": "==", "threshold": 0, "unit": "count"},
    {"metric": "joint_limit_violation_count", "operator": "==", "threshold": 0, "unit": "count"},
    {"metric": "velocity_limit_violation_count", "operator": "==", "threshold": 0, "unit": "count"},
    {"metric": "acceleration_limit_violation_count", "operator": "==", "threshold": 0, "unit": "count"},
    {"metric": "scene_clean", "operator": "==", "threshold": true, "unit": null},
    {"metric": "reset_status", "operator": "==", "threshold": "success", "unit": null}
  ]
}
